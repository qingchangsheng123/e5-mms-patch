#!/bin/sh /etc/rc.common
# e5-data-ondemand —— 按需蜂窝数据（平时断开，有短信待推送才拨号）
# START=97: 在 network(20)/modemmanager(70) 之后
START=97
STOP=12
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /bin/sh /etc/e5/power/data-ondemand.sh run
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# 停服务要把数据恢复到「断开」的省电状态：先清手动保持标记，再挂断。
	# v1.0.8 及以前这里调的是 up（拨号），语义反了：stop && disable 会把 PDP
	# 拨起来，而守护已经停了，再没有人来挂断，整机回到 600-900mW 常连态。
	# 短信走信令通道，与 PDP 无关，断开不影响收发。
	rm -f /tmp/.e5-do.hold
	[ -x /etc/e5/power/data-ondemand.sh ] && /bin/sh /etc/e5/power/data-ondemand.sh down >/dev/null 2>&1
	return 0
}
