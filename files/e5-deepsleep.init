#!/bin/sh /etc/rc.common
# e5-deepsleep: 熄屏且未插线时循环进入深度休眠
START=99
STOP=10
USE_PROCD=1

start_service()
{
	procd_open_instance
	procd_set_param command /usr/sbin/e5-deepsleep
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}

stop_service()
{
	[ -f /run/e5-deepsleep.pid ] && kill "$(cat /run/e5-deepsleep.pid)" 2>/dev/null
	sleep 1
}
